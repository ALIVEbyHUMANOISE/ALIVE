    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- head -->
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M19.6,14 A4.4,4.4 0 1,1 28.4,14 A4.4,4.4 0 1,1 19.6,14 Z" />

    <!-- spine -->
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M24,18.6 Q24.6,24.4 24,30" />

    <!-- arms, one at the side, one lifting slightly -->
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M24,22 Q20.2,24 18.6,26.8" />
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M24,22 Q28.2,24.6 29.8,27.4" />

    <!-- legs, mid-step -->
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M24,30 Q21.4,35 20,40.4" />
    <path
        android:strokeColor="@color/alive_ink"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M24,30 Q27.2,35.2 28.8,40.6" />

    <!-- the opening, drawn as a single light line -->
    <path
        android:strokeColor="@color/alive_forest"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M37,8 Q38,25 37,42" />
