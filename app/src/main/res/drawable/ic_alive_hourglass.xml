<?xml version="1.0" encoding="utf-8"?>
<!-- ALIVE's mark: a pixel hourglass on the same 16x16 grid as every sprite.

     Ink frame, reward-gold sand - the two colours that already mean "time" and
     "what you earned" everywhere else in the app. The shape is drawn the way an
     hourglass is actually read: a plinth wider than the glass at each end, the
     walls converging to a neck that stays open for one row, and a fall of sand
     through it. An earlier version let the walls close at the waist, which
     joined the two cones into one solid diamond and read as a bowtie. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <path
        android:fillColor="@color/alive_ink"
        android:pathData="M2,1h12v1h-12zM3,2h10v1h-10zM3,12h10v1h-10zM2,13h12v1h-12zM3,3h1v1h-1zM12,3h1v1h-1zM4,4h1v1h-1zM11,4h1v1h-1zM5,5h1v1h-1zM10,5h1v1h-1zM6,6h1v1h-1zM9,6h1v1h-1zM6,7h1v1h-1zM9,7h1v1h-1zM6,8h1v1h-1zM9,8h1v1h-1zM5,9h1v1h-1zM10,9h1v1h-1zM4,10h1v1h-1zM11,10h1v1h-1zM3,11h1v1h-1zM12,11h1v1h-1z" />
