<?xml version="1.0" encoding="utf-8"?>
<!-- Soft forest surface: something has actually landed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_ink" />
        </shape>
    </item>
    <item
        android:right="@dimen/shadow_offset"
        android:bottom="@dimen/shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_soft_forest" />
            <stroke
                android:width="@dimen/border_bold"
                android:color="@color/alive_ink" />
        </shape>
    </item>
</layer-list>
