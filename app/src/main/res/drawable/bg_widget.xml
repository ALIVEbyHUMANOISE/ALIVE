<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: the app's surface, small - paper, an ink edge, and the
     hard offset shadow every other card in ALIVE has. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_ink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_paper" />
            <stroke
                android:width="2dp"
                android:color="@color/alive_ink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
