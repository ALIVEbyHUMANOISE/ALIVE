<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet surface: border only, no shadow. For sections that should not
     compete with the one block that carries weight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_white" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink_hairline" />
        </shape>
    </item>
</layer-list>
