<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's allowance bar: the app's own meter, in a control the platform
     lets a widget resize at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_paper" />
            <stroke
                android:width="2dp"
                android:color="@color/alive_ink" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/alive_forest" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
