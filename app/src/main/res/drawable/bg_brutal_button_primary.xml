<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile primary action, in the colour of an offer: amber. Resting: the face
     sits up and left with a hard ink shadow showing. Pressed: the shadow
     collapses and the face fills its bounds, which reads as physically pushed
     down. Disabled: outline only.

     Amber, not forest, since the reference pass: a button is the one thing on a
     screen that says "press me", and forest is what ALIVE itself is - the meter,
     the selected nav block, the chart's spent bars. Reward gold stays a different
     yellow (#E0A526, deeper) and never appears on a button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_ink" />
                    <corners android:radius="@dimen/radius_tile" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_amber_action" />
                    <stroke
                        android:width="@dimen/border_bold"
                        android:color="@color/alive_ink" />
                    <corners android:radius="@dimen/radius_tile" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_warm_gray" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink_disabled" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_ink" />
                    <corners android:radius="@dimen/radius_tile" />
                </shape>
            </item>
            <item
                android:right="@dimen/shadow_offset"
                android:bottom="@dimen/shadow_offset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_amber_action" />
                    <stroke
                        android:width="@dimen/border_bold"
                        android:color="@color/alive_ink" />
                    <corners android:radius="@dimen/radius_tile" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
