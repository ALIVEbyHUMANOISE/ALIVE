<?xml version="1.0" encoding="utf-8"?>
<!-- Nav icon, pixel: a solid house with a door cut through it.
     The nav tints every icon to one colour, so the icon has to read as a
     silhouette - the door is a hole in the path (evenOdd), not a second fill
     that the tint would flatten into the walls. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <path
        android:fillColor="@color/alive_ink"
        android:fillType="evenOdd"
        android:pathData="M7,2h2v1h-2zM6,3h4v1h-4zM5,4h6v1h-6zM4,5h8v1h-8zM3,6h10v1h-10zM4,7h8v7h-8zM7,11h2v3h-2z" />
</vector>
