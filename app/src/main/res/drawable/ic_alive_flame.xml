<?xml version="1.0" encoding="utf-8"?>
<!-- ALIVE mark: a flame, on the same 16x16 grid as every sprite.

     Three tones, the way fire is actually drawn: an ink contour because it sits
     on the pale-gold streak tile, a red body, and a bright yellow core at the
     base where the heat is. An all-gold flame read as a brown blob next to the
     gold pips, which is the opposite of what a flame is for.

     The tip leans right so it reads as fire and not as a leaf. Two rows at the
     bottom of the box are left empty on purpose - see AliveComponents' mark,
     which offsets by exactly that much so the base lands on the baseline. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <path
        android:fillColor="@color/alive_red_short_mid"
        android:pathData="M9,3h1v1h-1zM8,4h2v1h-2zM7,5h3v1h-3zM6,6h5v1h-5zM6,7h5v1h-5zM6,8h5v1h-5zM5,9h7v1h-7zM5,10h7v1h-7zM5,11h7v1h-7zM5,12h7v1h-7z" />
