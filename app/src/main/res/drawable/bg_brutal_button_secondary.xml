<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile secondary action: paper face, ink border, same hard shadow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_ink" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_white" />
                    <stroke
                        android:width="@dimen/border_bold"
                        android:color="@color/alive_ink" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_white" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink_disabled" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_ink" />
                </shape>
            </item>
            <item
                android:right="@dimen/shadow_offset"
                android:bottom="@dimen/shadow_offset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/alive_white" />
                    <stroke
                        android:width="@dimen/border_bold"
                        android:color="@color/alive_ink" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
