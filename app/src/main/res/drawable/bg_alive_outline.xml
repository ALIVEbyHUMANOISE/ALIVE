<?xml version="1.0" encoding="utf-8"?>
<!-- Ink outline: the single current thing in flight. A hand-inked 1dp stroke
     on paper, radius kept small so it reads as drawn, not as a Material card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/alive_paper" />
    <stroke
        android:width="@dimen/stroke_ink"
        android:color="@color/alive_ink_hairline" />
    <corners android:radius="@dimen/radius_ink" />
</shape>
