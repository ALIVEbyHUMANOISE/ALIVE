<?xml version="1.0" encoding="utf-8"?>
<!-- ALIVE's brutalist block: paper surface, thick ink border, and a hard ink
     shadow offset to the bottom-right. No blur, no elevation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_ink" />
        </shape>
    </item>
    <item
        android:right="@dimen/shadow_offset"
        android:bottom="@dimen/shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_white" />
            <stroke
                android:width="@dimen/border_bold"
                android:color="@color/alive_ink" />
        </shape>
    </item>
</layer-list>
