<?xml version="1.0" encoding="utf-8"?>
<!-- The Home guard mark, looping: stand at ease, blink, sit down at the
     laptop, type, and come back to standing. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/ic_alive_character_aware" android:duration="1200" />
    <item android:drawable="@drawable/alive_anim_blink" android:duration="150" />
    <item android:drawable="@drawable/ic_alive_character_aware" android:duration="1600" />
    <item android:drawable="@drawable/alive_anim_blink" android:duration="150" />
    <item android:drawable="@drawable/ic_alive_character_aware" android:duration="900" />
    <item android:drawable="@drawable/alive_anim_laptop" android:duration="350" />
    <item android:drawable="@drawable/alive_anim_typing" android:duration="220" />
    <item android:drawable="@drawable/alive_anim_laptop" android:duration="220" />
    <item android:drawable="@drawable/alive_anim_typing" android:duration="220" />
    <item android:drawable="@drawable/alive_anim_laptop" android:duration="350" />
    <item android:drawable="@drawable/alive_anim_typing" android:duration="220" />
</animation-list>
