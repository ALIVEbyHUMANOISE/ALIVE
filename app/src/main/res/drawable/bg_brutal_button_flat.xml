<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet card's action: a paper face with a hairline ink edge and no hard
     shadow. The reference keeps this box on a zero-day rather than dropping the
     action to bare text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_soft_forest" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_white" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink_disabled" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_white" />
            <stroke
                android:width="@dimen/border_hairline"
                android:color="@color/alive_ink" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>
</selector>
