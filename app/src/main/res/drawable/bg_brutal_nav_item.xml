<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation selected state: a forest block with an ink edge. Square
     corners - the bar is a strip of keys, not a pill; the meter blocks the app
     counts minutes with wear the same radius. No offset shadow here: the bar
     is too short to show one honestly. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_forest" />
            <stroke
                android:width="@dimen/border_button"
                android:color="@color/alive_ink" />
            <corners android:radius="@dimen/radius_step" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_forest" />
            <stroke
                android:width="@dimen/border_button"
                android:color="@color/alive_ink" />
            <corners android:radius="@dimen/radius_step" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
