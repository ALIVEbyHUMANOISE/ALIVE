<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation selected state: a forest block with an ink edge.
     No offset shadow here - the bar is too short to show one honestly. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_forest" />
            <stroke
                android:width="@dimen/border_button"
                android:color="@color/alive_ink" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/alive_forest" />
            <stroke
                android:width="@dimen/border_button"
                android:color="@color/alive_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
