<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ALIVE base theme: paper background, ink text, forest identity.
         ALIVE is a light editorial palette per the Design Constitution. -->
    <style name="Theme.ProjectEgo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/alive_forest</item>
        <item name="colorPrimaryVariant">@color/alive_forest</item>
        <item name="colorOnPrimary">@color/alive_white</item>
        <item name="colorSecondary">@color/alive_forest</item>
        <item name="colorSecondaryVariant">@color/alive_forest</item>
        <item name="colorOnSecondary">@color/alive_white</item>
        <item name="android:colorBackground">@color/alive_paper</item>
        <item name="colorSurface">@color/alive_paper</item>
        <item name="colorOnSurface">@color/alive_ink</item>
        <item name="android:statusBarColor">@color/alive_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/alive_paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColorPrimary">@color/alive_ink</item>
        <item name="android:textColorSecondary">@color/alive_ink</item>
    </style>
</resources>
