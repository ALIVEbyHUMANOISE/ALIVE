<?xml version="1.0" encoding="utf-8"?>
<!-- ALIVE statistics widget: the same card language as the app, at home-screen
     size.

     RemoteViews cannot draw and cannot change a layout weight at runtime, so
     the composition is carried by the app colours on the rows and by one
     ProgressBar for the day's share of the allowance.

     Every text attribute here is written out longhand on purpose. The layout is
     inflated by the LAUNCHER's process with the launcher's own theme, and this
     app's text appearances inherit from MaterialComponents parents that resolve
     theme attributes the launcher has never heard of.

     The same host also refuses to build a bare android.view.View - it inflates
     only the classes RemoteViews documents - so the row chips are ImageViews
     carrying a finished colour rather than tinted placeholders. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_mark"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alive_hourglass" />

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/manrope_medium"
                android:includeFontPadding="false"
                android:text="@string/widget_stats_eyebrow"
                android:textColor="@color/alive_ink_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/silkscreen_bold"
            android:includeFontPadding="false"
            android:textColor="@color/alive_ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/widget_allowance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope_medium"
            android:includeFontPadding="false"
            android:textColor="@color/alive_ink_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/widget_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress" />

        <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_swatch_1" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:src="@drawable/widget_chip_first" />
            <TextView android:id="@+id/widget_name_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/alive_ink" android:textSize="14sp" />
            <TextView android:id="@+id/widget_minutes_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:textColor="@color/alive_ink_secondary" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_swatch_2" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:src="@drawable/widget_chip_second" />
            <TextView android:id="@+id/widget_name_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/alive_ink" android:textSize="14sp" />
            <TextView android:id="@+id/widget_minutes_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:textColor="@color/alive_ink_secondary" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_swatch_3" android:layout_width="10dp" android:layout_height="10dp" android:contentDescription="@null" android:src="@drawable/widget_chip_third" />
            <TextView android:id="@+id/widget_name_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/alive_ink" android:textSize="14sp" />
            <TextView android:id="@+id/widget_minutes_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/manrope_medium" android:includeFontPadding="false" android:textColor="@color/alive_ink_secondary" android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3sp"
            android:text="@string/widget_stats_empty"
            android:textColor="@color/alive_ink_secondary"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
