<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ALIVE Design Constitution palette (authoritative) -->
    <color name="alive_paper">#F5F1E8</color>
    <!-- The working surface: paper taken one step deeper so the grid on top of
         it stays faint, and blocks filled with alive_white read as laid on it. -->
    <color name="alive_canvas">#F1EBDC</color>
    <color name="alive_ink">#1D1D1B</color>
    <color name="alive_forest">#315C45</color>
    <color name="alive_soft_forest">#DCE5DC</color>
    <color name="alive_warm_gray">#D8D2C7</color>
    <color name="alive_white">#FFFDF8</color>

    <!-- Ink with alpha. These are the same ink hue, not new colors, so the
         palette stays six colors while still having a readable hierarchy.
         Warm gray is ~1.2:1 on paper and is never used for text. -->
    <color name="alive_ink_secondary">#B31D1D1B</color>
    <color name="alive_ink_muted">#991D1D1B</color>
    <color name="alive_ink_disabled">#611D1D1B</color>
    <color name="alive_ink_hairline">#4D1D1D1B</color>
    <color name="alive_ink_ripple">#1A1D1D1B</color>
    <color name="alive_forest_soft">#33315C45</color>

    <!-- ============ GAME ROLES: three more hues, one job each ============

         Names are roles, not colours, so nobody can spend `gold` on something
         that is not a reward. Each role has three tokens:

           _dark  text and edges. Measured to clear 4.5:1 on every ground in this
                  file, including the other roles' pales.
           _mid   fills only - step blocks, slices, swatches. It never carries
                  text: white on gold_mid is 2.2:1, and ink on red_mid is 4.3:1,
                  so a filled shape is labelled from outside, never on top.
           _pale  a surface to read ink on.

         The gold values are darker than they look on paper. The first draft
         (#8A6414) failed 4.5:1 on warm gray and on all three pales, which the
         palette test now refuses to let back in. -->
    <color name="alive_gold_reward_dark">#6F4E0C</color>
    <color name="alive_gold_reward_mid">#E0A526</color>
    <color name="alive_gold_reward_pale">#F6E7C2</color>

    <!-- Time that is thinning, and the door that closed. Never a large fill:
         a locked day is a pale surface with an ink edge, not a red card. -->
    <color name="alive_red_short_dark">#9E2F22</color>
    <color name="alive_red_short_mid">#D9553F</color>
    <color name="alive_red_short_pale">#F3DAD3</color>

    <!-- The work itself: a Focus session and what it allowed. -->
    <color name="alive_blue_work_dark">#27537A</color>
    <color name="alive_blue_work_mid">#4E86B4</color>
    <color name="alive_blue_work_pale">#D9E5EE</color>

    <!-- Legacy template colors kept for resource compatibility -->
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
