    <!-- ============ PERMISSIONS ============ -->
    <string name="permissions_heading">ALIVE can\'t see what it needs to</string>
    <string name="permissions_body">Usage access and the accessibility service are how ALIVE knows when your entertainment time is over. Until both are on, nothing on this screen is reliable.</string>
