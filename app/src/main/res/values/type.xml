<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography (Design Constitution sec.08).

         Three voices, deliberately limited:
           editorial  = serif      -> headings, statements, storytelling
           functional = sans-serif -> buttons, nav, timers, labels, data
           annotation = cursive    -> small asides and emphasis ONLY

         Sizes are explicit rather than inherited so the scale does not shift
         with the Material Components version, and every style stays at or
         above 13sp so accessibility font scaling stays readable. -->

    <!-- ============ EDITORIAL ============ -->

    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">23sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ALIVE.Statement" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ============ FUNCTIONAL ============ -->

    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/alive_forest</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="TextAppearance.ALIVE.BodySecondary" parent="TextAppearance.ALIVE.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
    </style>

    <style name="TextAppearance.ALIVE.QuestRowTitle" parent="TextAppearance.ALIVE.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Timers and minute counts: functional, tabular so digits do not jiggle. -->
    <style name="TextAppearance.ALIVE.Timer" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- ============ ANNOTATION (selective only) ============ -->

    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">cursive</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ============ ACTIONS ============ -->

    <!-- Restrained primary action: forest fill, warm-paper text, small radius. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_forest</item>
        <item name="android:textColor">@color/alive_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="rippleColor">@color/alive_ink_ripple</item>
    </style>

    <!-- ============ NAVIGATION ============ -->

    <!-- No active-indicator pill: selection is shown by ink vs muted ink. -->
    <style name="Widget.ALIVE.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/alive_paper</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.ALIVE.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.ALIVE.BottomNav.Indicator" parent="">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="color">@android:color/transparent</item>
    </style>

</resources>
