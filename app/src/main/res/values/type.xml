<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography foundation (Design Constitution sec.08):
         Editorial = headlines/statements/storytelling.
         Functional = buttons/nav/timers/data.
         System sans is used as the functional voice; serif as the
         editorial voice. Handwriting fonts are ONLY for selective
         annotations and are intentionally not defined yet. -->

    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ALIVE.Statement" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/alive_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/alive_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Restrained primary action button: forest fill, paper text. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_forest</item>
        <item name="android:textColor">@color/alive_white</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Editorial display for headlines -->
    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Section headers -->
    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/alive_forest</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Handwritten annotation style -->
    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/alive_warm_gray</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>