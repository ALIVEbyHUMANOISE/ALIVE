<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography: two pixel voices, zero system faces.

           press_start_2p  -> the arcade voice. Words only: the wordmark, card
                              titles, buttons, tags, big numbers. It has no
                              lowercase and every glyph is a square, so a
                              sentence set in it becomes a wall of capitals -
                              which is exactly what happened when it carried
                              32-to-96-character sentences and the bottom
                              navigation, and the hardest text on the screen got
                              harder. It keeps the short jobs, forever.

           vt323 (terminal) -> the reading voice. Sentences, paragraphs, notes,
                              nav labels. Narrow and lowercase-capable, so long
                              text stays legible while still reading as pixels.

         Every style kills the platform font padding and sets its own line
         spacing, because a bitmap face ships with metrics built for nobody:
         includeFontPadding=false is what stops mixed rows from sitting on
         different baselines, and lineSpacingExtra is the only leading these
         faces get. letterSpacing stays 0 everywhere - pixel grids are drawn,
         not tracked.

         The reading ladder steps 34 / 28 / 22 / 18 / 14 / 10, numbers run
         56 / 28, and every step sits at least 2sp from its neighbour. The
         reading voice sits ABOVE the old sans-serif ladder on purpose: vt323
         is narrow, so a size set in it reads one step smaller than the same
         number in sans-serif. Sentence case stays for the reading voice -
         arcade caps are already a stamp on every short label. -->

    <!-- ============ THE ARCANE VOICE (short) ============ -->

    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">-2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Card titles and section names: short enough for the arcade voice. -->
    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ THE READING VOICE (sentences) ============ -->

    <!-- The one sentence a card leads with. -->
    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Row titles and in-flight statements: what Statement and QuestRowTitle used
         to be, at one size instead of two that were indistinguishable. -->
    <style name="TextAppearance.ALIVE.Lead" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Support lines, disclosures, secondary prose. Same size as Body on purpose:
         it is the same kind of thing, said quieter. It replaces BodySecondary and
         quietText, and it is ink_secondary rather than ink_muted because these are
         real sentences and ink_muted sits under 4.5:1 on the canvas. -->
    <style name="TextAppearance.ALIVE.Note" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink_secondary</item>
    </style>

    <!-- The small grey line beside a tile: "24 quests", "2 routes". It is not a
         note (18sp prose) and not a tag (10sp arcade caps), and a two-column grid
         has no room for either of those next to an icon. -->
    <style name="TextAppearance.ALIVE.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A note, not a paragraph. Sized at the Lead step so the reading ladder
         stays six sizes; it looks smaller than 22sp because vt323 is narrow,
         which is why a terminal line reads as an aside and not a shout. -->
    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ TAGS: the arcade voice at its smallest ============ -->

    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ============ NUMBERS: the arcade voice, big and small ============ -->

    <style name="TextAppearance.ALIVE.Timer" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A ledger number: the same face as the hero, one step down. -->
    <style name="TextAppearance.ALIVE.Number" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- ============ FORM ============ -->

    <!-- The Body size, in the reading voice. -->
    <style name="TextAppearance.ALIVE.Option" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Input" parent="TextAppearance.ALIVE.Option">
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textColorHint">@color/alive_ink_disabled</item>
    </style>

    <!-- ============ ACTIONS ============ -->

    <!-- 15sp: the arcade face at 13 read as fine print next to the 18sp body.
         The longest action labels wrap to a second centred line on narrow
         screens, which the button shape wears fine; too-small text on the
         thing you are being asked to press was the worse trade. -->
    <style name="TextAppearance.ALIVE.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The theme's default button. ALIVE's own buttons are AppCompat over
         hard-shadow drawables and set their own appearance; this exists so any
         Material control inherits the same voice instead of the platform one. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_amber_action</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_tile</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/alive_ink_ripple</item>
    </style>

    <!-- ============ NAVIGATION ============ -->

    <!-- Permanent navigation in the arcade face was the least legible text on
         the screen and it could not be skipped by scrolling past it. The
         terminal voice keeps it pixel while keeping it readable. -->
    <style name="TextAppearance.ALIVE.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.ALIVE.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/alive_paper</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.ALIVE.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <!-- 32dp on the same 16 grid as every other sprite; it was 24dp, which
             puts a 16-cell icon on 1.5 pixels per cell. -->
        <item name="itemIconSize">@dimen/nav_icon_size</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.ALIVE.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.ALIVE.NavLabel</item>
    </style>

    <!-- The selected state is a block behind the item, so the pill indicator
         would fight it. -->
    <style name="Widget.ALIVE.BottomNav.Indicator" parent="">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="color">@android:color/transparent</item>
    </style>

</resources>
