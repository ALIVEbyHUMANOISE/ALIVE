<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography: two working faces and one accent.

           silkscreen (regular + bold) -> the voice of titles and figures: the
              wordmark, card titles, headlines, the character's one-line note,
              and every prominent number. It is a pixel face with real
              lowercase, so it carries the game identity without turning a
              sentence into a wall of capitals.

           ibm_plex_mono (regular + bold) -> the voice of the interface: body
              text, descriptions, buttons, navigation, settings, form fields,
              and the small grey lines. Monospaced and open, it is the most
              legible thing on the screen at phone size, which is what text
              you have to read - not just look at - is for.

           press_start_2p -> badges only. Ten glyphs, one line, never a
              sentence: it is the loudest face here, and it stays in the
              corner of the design where loud is the point.

         Every style kills the platform font padding and sets its own line
         spacing, because these faces ship metrics built for nobody:
         includeFontPadding=false is what keeps a mixed row (a 28sp figure
         beside a 14sp unit) on one baseline, and lineSpacingExtra is the only
         leading they get. letterSpacing stays 0 everywhere - pixel and mono
         faces are drawn, not tracked.

         The ladder steps 34 / 26 / 22 / 18 / 14 / 10, figures run 56 / 28,
         and nothing sits two steps apart by less than 2sp. -->

    <!-- ============ TITLES AND FIGURES: SILKSCREEN ============ -->

    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">-2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The one sentence a card leads with. -->
    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Row titles and in-flight statements: what Statement and QuestRowTitle used
         to be, at one size instead of two that were indistinguishable. -->
    <style name="TextAppearance.ALIVE.Lead" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/silkscreen_regular</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Card titles and section names: short enough for the title face, and
         sentence case is a stamp's job, not this one's. -->
    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A note, not a paragraph: the character's own line, in the title face
         one step down from the Lead. -->
    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/silkscreen_regular</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ FIGURES: THE SAME FACE, BIG ============ -->

    <style name="TextAppearance.ALIVE.Timer" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A ledger number: the same face as the hero, one step down. -->
    <style name="TextAppearance.ALIVE.Number" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- ============ THE INTERFACE: IBM PLEX MONO ============ -->

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Support lines, disclosures, secondary prose. Same size as Body on purpose:
         it is the same kind of thing, said quieter. It replaces BodySecondary and
         quietText, and it is ink_secondary rather than ink_muted because these are
         real sentences and ink_muted sits under 4.5:1 on the canvas. -->
    <style name="TextAppearance.ALIVE.Note" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink_secondary</item>
    </style>

    <!-- The small grey line beside a tile: "24 quests", "2 routes", and the
         unit that rides the baseline of a figure. -->
    <style name="TextAppearance.ALIVE.Meta" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ============ BADGES: THE ACCENT, AND ITS LIMIT ============ -->

    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ============ FORM ============ -->

    <!-- The Body size, in the interface voice. -->
    <style name="TextAppearance.ALIVE.Option" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Input" parent="TextAppearance.ALIVE.Option">
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textColorHint">@color/alive_ink_disabled</item>
    </style>

    <!-- ============ ACTIONS ============ -->

    <!-- 16sp bold: the widest the mono face needs to be to read as an offer
         rather than a caption. The longest action labels still fit one line
         of a full-width button, because a monospace glyph is half as wide as
         the arcade face this replaced. -->
    <style name="TextAppearance.ALIVE.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/ibm_plex_mono_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The theme's default button. ALIVE's own buttons are AppCompat over
         hard-shadow drawables and set their own appearance; this exists so any
         Material control inherits the same voice instead of the platform one. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_amber_action</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/ibm_plex_mono_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_tile</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/alive_ink_ripple</item>
    </style>

    <!-- ============ NAVIGATION ============ -->

    <!-- The bottom bar's key labels, in the interface voice: permanent
         navigation is read at arm's length and it cannot be skipped by
         scrolling past, so it gets the most legible face in the file. -->
    <style name="TextAppearance.ALIVE.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/ibm_plex_mono_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
