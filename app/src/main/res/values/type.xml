<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ALIVE typography. Three faces, each with exactly one job:

           sans-serif-black  -> the reading ladder: display, headings, body, buttons, nav
           vt323 (terminal)  -> numbers and notes: the machine-read voice
           press_start_2p    -> tags ONLY. Ten glyphs maximum, one line, never a
                                sentence and never a heading.

         The ladder is six sizes with a real step between each (34 / 26 / 20 / 16 /
         13 / 10). It used to have Statement 19, QuestRowTitle 19 and Annotation 18
         side by side, plus 15 / 15 / 16 / 17 in one band - four "levels" of type
         that read as one size, which is how a screen ends up flat.

         The pixel face is the one that got demoted by this file. It is ALIVE's
         game voice and it is beautiful at four or five glyphs; at ten sp it took
         32-to-96-character sentences and the bottom navigation, and those became
         the hardest things on the screen to read. -->

    <!-- ============ READING LADDER ============ -->

    <style name="TextAppearance.ALIVE.Display" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- The one sentence a card leads with. -->
    <style name="TextAppearance.ALIVE.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Row titles and in-flight statements: what Statement and QuestRowTitle used
         to be, at one size instead of two that were indistinguishable. -->
    <style name="TextAppearance.ALIVE.Lead" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.ALIVE.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

    <!-- Support lines, disclosures, secondary prose. Same size as Body on purpose:
         it is the same kind of thing, said quieter. It replaces BodySecondary and
         quietText, and it is ink_secondary rather than ink_muted because these are
         real sentences and ink_muted sits under 4.5:1 on the canvas. -->
    <style name="TextAppearance.ALIVE.Note" parent="TextAppearance.ALIVE.Body">
        <item name="android:textColor">@color/alive_ink_secondary</item>
    </style>

    <!-- Card titles, field labels, meta lines. The tracking came down from 0.16:
         at that width "TIME BANK · MIN" could not fit a ledger cell on one line. -->
    <style name="TextAppearance.ALIVE.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ============ TAGS: the pixel voice, and its limit ============ -->

    <style name="TextAppearance.ALIVE.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ============ NUMBERS AND NOTES: the terminal voice ============ -->

    <style name="TextAppearance.ALIVE.Timer" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A ledger number: the same face as the hero, one step down. -->
    <style name="TextAppearance.ALIVE.Number" parent="TextAppearance.ALIVE.Timer">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- A note, not a paragraph. Sized at the Lead step so the reading ladder
         stays six sizes; it looks smaller than 20sp because vt323 is narrow,
         which is why a terminal line reads as an aside and not a shout. -->
    <style name="TextAppearance.ALIVE.Annotation" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/vt323</item>
        <item name="android:textColor">@color/alive_ink_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ============ FORM ============ -->

    <!-- 16sp, the Body size. It used to be 17, which made a fourth value inside
         the 15-17 band and gave the form its own near-duplicate step. -->
    <style name="TextAppearance.ALIVE.Option" parent="TextAppearance.ALIVE.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/alive_ink</item>
    </style>

    <style name="TextAppearance.ALIVE.Input" parent="TextAppearance.ALIVE.Option">
        <item name="android:textColor">@color/alive_ink</item>
        <item name="android:textColorHint">@color/alive_ink_disabled</item>
    </style>

    <!-- ============ ACTIONS ============ -->

    <style name="TextAppearance.ALIVE.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- The theme's default button. ALIVE's own buttons are AppCompat over
         hard-shadow drawables and set their own appearance; this exists so any
         Material control inherits the same voice instead of the platform one. -->
    <style name="Widget.ALIVE.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/alive_forest</item>
        <item name="android:textColor">@color/alive_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="cornerRadius">@dimen/radius_none</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/alive_ink_ripple</item>
    </style>

    <!-- ============ NAVIGATION ============ -->

    <!-- Permanent navigation in a 10sp pixel face was the least legible text on
         the screen and it could not be skipped by scrolling past it. -->
    <style name="TextAppearance.ALIVE.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Widget.ALIVE.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/alive_paper</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.ALIVE.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.ALIVE.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.ALIVE.NavLabel</item>
    </style>

    <!-- The selected state is a block behind the item, so the pill indicator
         would fight it. -->
    <style name="Widget.ALIVE.BottomNav.Indicator" parent="">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="color">@android:color/transparent</item>
    </style>

</resources>
