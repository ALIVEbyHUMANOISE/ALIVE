<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ALIVE base theme: paper background, ink text, forest identity.
         ALIVE is a light editorial palette per the Design Constitution.

         values-night/themes.xml is intentionally identical to this file:
         ALIVE stays on paper, so night mode must not diverge. Edit both. -->
    <style name="Theme.ProjectEgo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/alive_forest</item>
        <item name="colorPrimaryVariant">@color/alive_forest</item>
        <item name="colorOnPrimary">@color/alive_white</item>
        <item name="colorSecondary">@color/alive_forest</item>
        <item name="colorSecondaryVariant">@color/alive_forest</item>
        <item name="colorOnSecondary">@color/alive_white</item>
        <item name="android:colorBackground">@color/alive_canvas</item>
        <item name="colorSurface">@color/alive_paper</item>
        <item name="colorOnSurface">@color/alive_ink</item>
        <item name="android:windowBackground">@drawable/bg_canvas</item>
        <item name="android:statusBarColor">@color/alive_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/alive_paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- The loading splash: the same canvas the app opens onto, with the
             hourglass mark on it. No plate behind it - the mark reads on its
             own, and a circle would only shrink the thing inside it. -->
        <item name="android:windowSplashScreenBackground">@drawable/bg_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_hourglass</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="android:textColorPrimary">@color/alive_ink</item>
        <item name="android:textColorSecondary">@color/alive_ink_secondary</item>
        <item name="android:textColorHint">@color/alive_ink_muted</item>

        <!-- The safety net for framework widgets that escape an ALIVE text
             appearance. Deliberately the android attribute only - an
             app-namespace fontFamily here outranks the text appearances on
             AppCompat widgets and silently repaints the buttons. -->
        <item name="android:fontFamily">@font/manrope_regular</item>

        <!-- Ink strokes instead of the Material defaults. The unselected ring is
             a hairline of ink so an empty radio matches every other hairline on
             the screen; the selected one is forest, which is the same colour the
             primary action and the selected nav block use - one meaning, one
             colour. -->
        <item name="colorControlNormal">@color/alive_ink_hairline</item>
        <item name="colorControlActivated">@color/alive_forest</item>
        <item name="colorControlHighlight">@color/alive_ink_ripple</item>
        <item name="colorOnBackground">@color/alive_ink</item>

        <!-- Every action button starts from this style. The outline and quiet
             variants are built in AliveComponents. -->
        <item name="materialButtonStyle">@style/Widget.ALIVE.Button.Primary</item>
    </style>
    <!-- The critical-time note: a floating card, centred, that dims the app
         underneath without hiding or stopping it. No entry animation on
         purpose - a card that arrives is an alarm; a card that is simply there
         is a note. -->
    <style name="Theme.ALIVE.CriticalAlert" parent="Theme.ProjectEgo">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Guardian's recovery popup. The same window as the critical note on
         purpose - a floating card, centred, dimming the app underneath without
         stopping it - because the two are the same kind of interruption and
         should not arrive looking like two different apps. -->
    <style name="Theme.ALIVE.GuardianAlert" parent="Theme.ALIVE.CriticalAlert" />
</resources>
