    <!-- ============ GUARDIAN ============

         Guardian itu nama dan wajah dari state penjaga - bukan aturan kedua.
         Layanan yang menutup aplikasi bisa dimatikan dan Android nggak
         mengizinkan app mencegahnya, jadi harganya dibayar di dalam ALIVE:
         harinya ditandai, tandanya kelihatan sampai ada misi yang membayarnya,
         dan salinannya nggak pernah mengaku tahu siapa yang mematikannya - dan
         nggak pernah mengaku Guardian bisa mencegahnya. -->
    <string name="guardian_name">Guardian</string>
    <string name="guardian_active_heading">Penjagaan nyala</string>
    <string name="guardian_active_body">Aksesibilitasnya nyala, jadi app hiburan ditutup saat waktunya habis.</string>
    <string name="guardian_degraded_heading">Guardian kehilangan pijakan</string>
    <string name="guardian_degraded_body">Aksesibilitas ALIVE dimatikan, jadi belum ada yang ditutup. Hari ini juga belum ditandai - nyalakan lagi supaya tetap begitu.</string>
    <string name="guardian_recovery_heading">Hari ini butuh dipulihkan</string>
    <string name="guardian_recovery_body">Penjaganya mati dan jatah hiburannya sudah kelewat. Nyalakan lagi, lalu selesaikan satu misi: tandanya hilang dan runtunanmu aman.</string>
    <string name="guardian_restored_heading">Penjagaan sudah pulih</string>
    <string name="guardian_restored_body">Tidak ada yang terlewat lagi. Hari ini tetap tercatat pernah punya bagian tanpa penjaga, karena bagian itu memang terjadi.</string>
    <string name="guardian_note_off">ALIVE tidak bisa tahu kamu yang mematikannya atau ponsel yang melakukannya demi baterai. Selama mati, tidak ada yang menjaga jatahmu.</string>
