    <string name="guardian_action_restore">Pulihkan penjagaan</string>
    <string name="guardian_later">Nanti</string>
    <string name="guardian_why">Kenapa aku lihat ini?</string>
    <string name="permissions_overlay_why">Satu izin lagi, cuma buat Guardian: "tampilkan di atas aplikasi lain". Itu yang bikin popup pemulihannya bisa muncul di atas app hiburan - sebentar saja, selama penjaganya mati - dan itu satu-satunya hal yang pernah ALIVE gambar di atas app lain.</string>
    <string name="permissions_overlay_action">Izinkan tampil di atas app lain</string>
    <string name="guard_profile_line">Hari ini punya bagian tanpa penjaga.</string>
