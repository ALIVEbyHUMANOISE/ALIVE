<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Step-count evidence for physical quests (API 29+ runtime permission;
         below Q the step counter needs none). Play Data Safety must declare
         Physical activity collection. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Names for the apps the chart counts. Without these declarations Android
         11+ hides every other package's label, and the chart falls back to a
         fragment of the package name ("Trill" instead of "TikTok"). Must stay
         in step with KNOWN_ENTERTAINMENT_PACKAGES and TRACKED_PACKAGES in
         AppClassifier.kt. -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.spotify.music" />
        <package android:name="com.pinterest" />
        <package android:name="com.bilibili.app.in" />
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.brave.browser" />
        <package android:name="com.mobile.legends" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.roblox.client" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectEgo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The first-run welcome. Not exported and never in recents: it is not
             a place, it is a door that opens once. -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="false" />

        <!-- The critical-time note. singleInstance + empty taskAffinity keep it
             out of the main task entirely, and noHistory means a stale card can
             never be restored on top of something else later. Only the
             accessibility service starts it, hence exported=false. -->
        <activity
            android:name=".ui.CriticalAlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.ALIVE.CriticalAlert" />

        <service
            android:name=".service.EgoAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The home-screen widget. Exported must be true: the launcher runs in
             its own process and is the one that binds this receiver, so an
             unexported component is invisible to it and the picker answers
             "couldn't add widget". -->
        <receiver
            android:name=".ui.widget.AliveStatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alive_stats_widget_info" />
        </receiver>

    </application>
</manifest>
