<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Step-count evidence for physical quests (API 29+ runtime permission;
         below Q the step counter needs none). Play Data Safety must declare
         Physical activity collection. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- One ongoing notification, and only one: it says the guard is off until
         the guard is back on (API 33+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Guardian's recovery popup draws over whatever app is open, which is the
         one thing no app can do without this grant. Asked for with a plain
         sentence, and used only while the guard is off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The watch that looks for an entertainment app while the guard is off. A
         foreground service is required: Android does not let a background process
         read the usage log. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Names for the apps the chart counts. Without these declarations Android
         11+ hides every other package's label, and the chart falls back to a
         fragment of the package name ("Trill" instead of "TikTok"). Must stay
         in step with KNOWN_ENTERTAINMENT_PACKAGES and TRACKED_PACKAGES in
         AppClassifier.kt. -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.spotify.music" />
        <package android:name="com.pinterest" />
        <package android:name="com.bilibili.app.in" />
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.brave.browser" />
        <package android:name="com.mobile.legends" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.roblox.client" />
        <package android:name="com.supercell.clashofclans" />
        <package android:name="com.supercell.clashroyale" />
        <package android:name="com.supercell.brawlstars" />
        <package android:name="com.supercell.hayday" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.innersloth.spacemafia" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Money. Visible in the free lens, so their labels have to resolve
             like any other named package - see AppClassifier.MONEY_PACKAGES. -->
        <package android:name="id.dana" />
        <package android:name="com.gojek.app" />
        <package android:name="com.shopee.id" />
        <package android:name="com.tokopedia.tkpd" />
        <package android:name="id.co.ovo" />
        <package android:name="id.co.bri.brimo" />
        <package android:name="com.bca.mybca" />
        <package android:name="id.bmri.livin" />
        <package android:name="src.com.bni" />
        <package android:name="com.bsm.bankbsm" />
        <package android:name="com.btpn.dc" />
        <package android:name="com.jago.digitalBanking" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectEgo">

        <!-- The pill: summoned from the quick settings tile, gone the moment the
             person asks or the process dies. specialUse because none of the
             declared types describe "small window on top", and it is honest
             about being exactly that. -->
        <service
            android:name=".service.InfoPillService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A small always-on-top reading of the user's own screen time" />
        </service>

        <!-- The button that summons it. Exported because the system's shade is
             the caller, behind the platform's own bind permission. -->
        <service
            android:name=".service.InfoPillTile"
            android:exported="true"
            android:icon="@drawable/ic_alive_hourglass"
            android:label="@string/pill_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The nightly note about tomorrow's promise. Not exported: the only
             sender that matters is this app's own alarm. -->
        <receiver
            android:name=".service.PromiseWatchReceiver"
            android:exported="false" />

        <!-- The mid-afternoon note about the quest that promise named. -->
        <receiver
            android:name=".service.QuestWatchReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The first-run welcome. Not exported and never in recents: it is not
             a place, it is a door that opens once. -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="false" />

        <!-- The critical-time note. singleInstance + empty taskAffinity keep it
             out of the main task entirely, and noHistory means a stale card can
             never be restored on top of something else later. Only the
             accessibility service starts it, hence exported=false. -->
        <activity
            android:name=".ui.CriticalAlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.ALIVE.CriticalAlert" />

        <service
            android:name=".service.EgoAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Guardian's popup: the recovery note, over whatever app is open. -->
        <activity
            android:name=".ui.GuardianAlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.ALIVE.GuardianAlert" />

        <!-- The watch behind that popup. It runs only while the guard is off. -->
        <service
            android:name=".service.GuardianWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the usage log for entertainment apps while screen-time protection is off, so Guardian can offer to restore it." />
        </service>

        <!-- The home-screen widget. Exported must be true: the launcher runs in
             its own process and is the one that binds this receiver, so an
             unexported component is invisible to it and the picker answers
             "couldn't add widget". -->
        <receiver
            android:name=".ui.widget.AliveStatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stats_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alive_stats_widget_info" />
        </receiver>

        <!-- The guard's one notification: posted when the accessibility service
             is switched off, and re-posted by an alarm until it is switched back
             on. Not exported - nothing outside ALIVE has any business firing it. -->
        <receiver
            android:name=".service.AccessibilityWatchReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.projectego.app.action.GUARD_CHECK" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
